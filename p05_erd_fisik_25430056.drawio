ded=0;strokeColor=#333333;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.625;entryX=1;entryY=0.526;" value="melayani" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" source="peminjaman" target="detail" style="endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=14;startSize=14;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="berisi" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" source="eksemplar" target="detail" style="endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=14;startSize=14;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.469;entryX=1;entryY=0.268;" value="tercantum di" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" source="koleksi" target="eksemplar" style="endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=14;startSize=14;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.234;entryX=1;entryY=0.469;" value="memiliki" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c1a" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1" vertex="1"><mxGeometry height="20" width="30" x="642" y="168" as="geometry" /></mxCell><mxCell id="c1b" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="0..N" vertex="1"><mxGeometry height="20" width="44" x="752" y="168" as="geometry" /></mxCell><mxCell id="c2a" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1" vertex="1"><mxGeometry height="20" width="30" x="1528" y="158" as="geometry" /></mxCell><mxCell id="c2b" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="0..N" vertex="1"><mxGeometry height="20" width="44" x="1402" y="158" as="geometry" /></mxCell><mxCell id="c3a" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1" vertex="1"><mxGeometry height="20" width="30" x="1106" y="254" as="geometry" /></mxCell><mxCell id="c3b" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1..N" vertex="1"><mxGeometry height="20" width="44" x="1106" y="392" as="geometry" /></mxCell><mxCell id="c4a" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1" vertex="1"><mxGeometry height="20" width="30" x="1528" y="458" as="geometry" /></mxCell><mxCell id="c4b" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="0..N" vertex="1"><mxGeometry height="20" width="44" x="1402" y="458" as="geometry" /></mxCell><mxCell id="c5a" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1" vertex="1"><mxGeometry height="20" width="30" x="2288" y="458" as="geometry" /></mxCell><mxCell id="c5b" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1..N" vertex="1"><mxGeometry height="20" width="44" x="2162" y="458" as="geometry" /></mxCell><mxCell id="note" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" value="tarif disalin ke tarif_denda_detail_peminjaman (AB-10), tanpa kunci tamu dan tanpa garis relasi" vertex="1"><mxGeometry height="60" width="144" x="648" y="455" as="geometry" /></mxCell><mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;strokeColor=#999999;fillColor=#ffffff;fontSize=12;" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;1 = tepat satu | 0..1 = nol atau satu | 0..N = nol atau banyak | 1..N = satu atau banyak. Simbol dekat kotak = maksimum; simbol yang lebih jauh = minimum.&lt;br&gt;PK = kunci primer | FK = kunci tamu | PK,FK = kunci primer komposit sekaligus kunci tamu | UQ = unik | AI = AUTO_INCREMENT | NN = NOT NULL | DEF = DEFAULT | CK = CHECK | -&gt; tabel tujuan kunci tamu.&lt;br&gt;Baris berlatar kuning bertanda [DATA PRIBADI]: nim_anggota, nama_anggota, no_hp_anggota (akses terbatas, lihat kamus data P02). Semua kunci tamu memakai ON DELETE RESTRICT: riwayat peminjaman disimpan minimal 5 tahun.&lt;br&gt;CHECK tingkat baris pada detail_peminjaman: (status_item = 'kembali') = (tgl_kembali terisi) [AB-08]; (status_item = 'hilang') = (jenis_ganti_rugi terisi) [AB-12]; (jenis_ganti_rugi = 'bayar') = (biaya_ganti_rugi terisi) [AB-12]. Awalan kode koleksi sesuai jenis (BK/MJ/JR).&lt;br&gt;Atribut turunan (dihitung, tidak digambar sebagai kolom): jumlah_koleksi_dipinjam, tgl_jatuh_tempo (tgl_pinjam + 7 hari, AB-06), hari_terlambat. denda_detail_peminjaman disimpan karena dibayar tunai (AB-11).&lt;br&gt;Belum dapat dijaga struktur (Modul 14): maksimal 5 koleksi per peminjaman (P + 2, AB-05), anggota aktif (AB-02), eksemplar tersedia (AB-04), satu eksemplar satu peminjaman terbuka (AB-07), tgl_kembali tidak lebih awal dari tgl_pinjam (AB-08)." vertex="1"><mxGeometry height="190" width="2880" x="40" y="740" as="geometry" /></mxCell><mxCell id="sign" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=right;verticalAlign=middle;" value="Zahra Zakia An Nur - 25430056" vertex="1"><mxGeometry height="28" width="400" x="2520" y="950" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>